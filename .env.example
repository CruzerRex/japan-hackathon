# Kizuna Forge configuration. Copy to `.env` (never commit `.env`).
# Every value has a safe default; the app runs with no .env at all.

# --- Server -------------------------------------------------------------------------------
# Interface and port to listen on. Use 0.0.0.0 only behind a TLS-terminating reverse proxy.
KIZUNA_HOST=127.0.0.1
KIZUNA_PORT=8000

# --- Storage ------------------------------------------------------------------------------
# Folder for the SQLite database and uploaded recordings (kept outside the web root).
KIZUNA_DATA_DIR=./data
# Optional explicit paths (default to inside KIZUNA_DATA_DIR)
# KIZUNA_DB_PATH=./data/kizuna.db
# KIZUNA_UPLOAD_DIR=./data/uploads
# Global upload ceiling in MB (images/documents/transcripts have lower per-type limits).
KIZUNA_MAX_UPLOAD_MB=200

# --- Demo ---------------------------------------------------------------------------------
# true  = the sign-in page offers one-click personas for the SIMULATED demo organisation only.
# false = password sign-in only (use for any real deployment).
KIZUNA_DEMO_MODE=true

# --- Sessions & cookies ---------------------------------------------------------------------
KIZUNA_SESSION_TTL_HOURS=12
# Set true when served over HTTPS so the session cookie is marked Secure.
KIZUNA_COOKIE_SECURE=false

# --- Logging ------------------------------------------------------------------------------
KIZUNA_LOG_LEVEL=INFO
# true = JSON lines (for log shipping); false = human-readable
KIZUNA_LOG_JSON=true

# --- Optional: Claude via the Anthropic API ---------------------------------------------------
# Disabled by default. When enabled (and `pip install anthropic` has been run), "Claude" appears
# as an extraction provider and the knowledge assistant composes answers from retrieved passages.
# The key stays on the server and is never sent to the browser. Failures are reported, never faked.
KIZUNA_ANTHROPIC_ENABLED=false
ANTHROPIC_API_KEY=sk-ant-REPLACE_ME
KIZUNA_ANTHROPIC_MODEL=claude-opus-5-5
KIZUNA_ANTHROPIC_TIMEOUT_S=90
